{
    "name": "ROS Humble FR3",
    "dockerComposeFile": ["docker-compose.yml"],
    "service": "ros_humble_fr3",
    "workspaceFolder": "/workspace",
    "customizations": {
        "vscode": {
            "settings": {
                "terminal.integrated.shell.linux": "/bin/bash"
            },
            "extensions": [
                "ms-vscode.cpptools",
                "ms-python.python"
            ]
        }
    },
    "remoteUser": "root"
}